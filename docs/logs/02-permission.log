# --- Git Bash(Windows NTFS)에서 시험 ---
$ cd practice/permission

$ touch perm_file.txt

$ mkdir perm_dir

$ ls -ld perm_file.txt perm_dir
drwxr-xr-x 1 yeonseo 197121 0 Nov  6 01:26 perm_dir
-rw-r--r-- 1 yeonseo 197121 0 Nov  6 01:26 perm_file.txt

$ chmod 600 perm_file.txt

$ chmod 700 perm_dir

$ ls -ld perm_file.txt perm_dir
drwxr-xr-x 1 yeonseo 197121 0 Nov  6 01:26 perm_dir
-rw-r--r-- 1 yeonseo 197121 0 Nov  6 01:26 perm_file.txt

$ stat -c "%a %A %n" perm_file.txt perm_dir
644 -rw-r--r-- perm_file.txt
755 drwxr-xr-x perm_dir


# --- ubuntu 컨테이너(리눅스 파일시스템)에서 수행 ---
